{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    // "types": ["./src/global.d.ts"],

    "jsx": "react-jsx",
    "jsxImportSource": "kt.js",
    "plugins": [{ "name": "@ktjs/ts-plugin" }],

    "declaration": false,
    "outDir": "dist",
    "rootDir": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "./src/**/*.ts",
    "./draft/**/*.ts",
    "*.config.ts",
    "./tests/**/*.ts",
    "./document/**/*.ts",
    "./document/**/*.tsx"
  ],
  "exclude": ["**/dist/**/*.js", "**/dist/**/*.d.ts", "**/example/**/code/**"]
}
